{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeoBoop",
  "version": "0.1.0",
  "identifier": "best.okat.neoboop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NeoBoop",
        "width": 900,
        "height": 600,
        "minWidth": 480,
        "minHeight": 320,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
